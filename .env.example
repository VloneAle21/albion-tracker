# Copia este archivo como .env y cambia las contraseñas.
# El archivo .env NO se sube a Git.

# Servidor de Albion: europa, america o asia
ALBION_SERVIDOR=europa

# MongoDB (en local con Docker, o la URL de MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017
MONGO_BD=albion_tracker

# Cada cuántos minutos consulta el worker a los jugadores seguidos
WORKER_MINUTOS=10

# MySQL o MariaDB
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_BD=albion_tracker
MYSQL_USER=tracker
MYSQL_PASSWORD=cambia_esto
# Solo para Docker: contraseña de root del contenedor de MySQL
MYSQL_ROOT_PASSWORD=cambia_esto_tambien

# Puertos de Docker en vuestro ordenador (cambiadlos si ya están ocupados)
DOCKER_PUERTO_MONGO=27017
DOCKER_PUERTO_MYSQL=3306
DOCKER_PUERTO_WEB=8501
